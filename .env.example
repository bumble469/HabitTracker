# Public backend origin only; API paths already include /api. No credentials.
# Development fallback when omitted: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# For a deployed frontend, set VITE_API_BASE_URL=https://your-backend.example
# Configure the BACKEND (not Vite) CORS_ORIGINS for the frontend's origins:
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
# If using http://127.0.0.1:5173, add that exact origin too.
